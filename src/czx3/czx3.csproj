<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 修改为本机 SuperMap iObjects .NET 2025 安装目录 -->
    <SuperMapIObjectsPath Condition="'$(SuperMapIObjectsPath)' == ''">C:\SuperMap\supermap-iobjectsdotnet-2025-all</SuperMapIObjectsPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.8.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.8.0" />
    <PackageReference Include="System.ValueTuple" Version="4.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SuperMap.Data">
      <HintPath>$(SuperMapIObjectsPath)\Bin_x64\SuperMap.Data.dll</HintPath>
    </Reference>
    <Reference Include="SuperMap.Data.CloudLicense">
      <HintPath>$(SuperMapIObjectsPath)\Bin_x64\SuperMap.Data.CloudLicense.dll</HintPath>
    </Reference>
    <Reference Include="SuperMap.Mapping">
      <HintPath>$(SuperMapIObjectsPath)\Bin_x64\SuperMap.Mapping.dll</HintPath>
    </Reference>
    <Reference Include="SuperMap.UI.Controls">
      <HintPath>$(SuperMapIObjectsPath)\Bin_x64\SuperMap.UI.Controls.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>